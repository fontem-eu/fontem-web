# Runtime SSR for the content routes.
#
# Separate from the main image on purpose: that one is hardened
# distroless nginx with no Node in it, and adding a Node runtime to get
# server rendering would give back the hardening for every static asset
# the site serves. Static stays static and hardened; only the routes
# that must render per request go through this.
#
# Docker Hardened Images, node 24 (dhi.void42.internal mirrors dhi.io). The
# runtime stage is glibc, Node and CA certificates: no shell, no npm, no
# apt, no system OpenSSL (Node carries its own). node:24-slim shipped all
# of those (Debian 12, 91 packages) and with them the only critical CVE
# left on the site (DEBIAN-CVE-2026-75803, system OpenSSL, 2026-09-29).
FROM dhi.void42.internal/node:24-dev@sha256:2e51e8397b85c3771c554834fb55d7fd5825e7d57a993e00153db42c584b7e58 AS build
WORKDIR /app
COPY void42-ca.crt /usr/local/share/ca-certificates/void42-ca.crt
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/void42-ca.crt

COPY package*.json .npmrc ./
RUN npm ci

COPY . .
# Produces dist/client (assets + prerendered pages + spa.html) and
# dist/server/entry-server.js, which this service imports to render.
RUN npm run build

# The render path needs vue/server-renderer and whatever the app bundle
# pulls in at runtime, so production deps ship with it. Installed here,
# where npm is; the runtime has none.
FROM dhi.void42.internal/node:24-dev@sha256:2e51e8397b85c3771c554834fb55d7fd5825e7d57a993e00153db42c584b7e58 AS deps
WORKDIR /app
COPY void42-ca.crt /usr/local/share/ca-certificates/void42-ca.crt
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/void42-ca.crt
COPY package*.json .npmrc ./
RUN npm ci --omit=dev && npm cache clean --force

# ── runtime ──────────────────────────────────────────────────────────
FROM dhi.void42.internal/node:24@sha256:f3575cf1e68ffe163703b691c465af833fd2d94cccc1e825d052c943018f2aa3
WORKDIR /app
# Node reads the void42 CA from here on top of its bundled roots; the
# runtime has no update-ca-certificates to fold it into the system store.
COPY void42-ca.crt /app/void42-ca.crt
ENV NODE_ENV=production \
    NODE_EXTRA_CA_CERTS=/app/void42-ca.crt

# package.json: "type": "module" is what makes server/*.js ES modules.
COPY package.json ./
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY server ./server
COPY src/ssr ./src/ssr

# Non-root, and NUMERIC. `USER node` is the same account (uid 1000 in
# the node images) but Kubernetes cannot verify a non-numeric user
# against runAsNonRoot: it refuses to start the container with
# "image has non-numeric user (node), cannot verify user is non-root".
USER 1000:1000
EXPOSE 8081
# Exec form: there is no /bin/sh to run a shell-form HEALTHCHECK with.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8081/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

CMD ["node", "server/ssr.js"]
