{
  "name": "fontem-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.js --outDir dist/server && node scripts/prerender.js",
    "preview": "vite preview --outDir dist/client",
    "test:unit": "vitest run --dangerouslyIgnoreUnhandledErrors",
    "test:ssr": "vitest run tests/ssr --dangerouslyIgnoreUnhandledErrors",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "vitest run --dangerouslyIgnoreUnhandledErrors",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
    "@tiptap/extension-bubble-menu": "^3.22.3",
    "@tiptap/extension-floating-menu": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/extension-table": "^3.22.3",
    "@tiptap/extension-table-cell": "^3.22.3",
    "@tiptap/extension-table-header": "^3.22.3",
    "@tiptap/extension-table-row": "^3.22.3",
    "@tiptap/extension-text-align": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/html": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.2",
    "@tiptap/vue-3": "^3.22.2",
    "d3": "^7.9.0",
    "dompurify": "^3.4.5",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "maplibre-gl": "^5.23.0",
    "marked": "^18.0.4",
    "sigma": "^3.0.2",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.50.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-istanbul": "^3.2.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.16",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "tmp": "^0.2.6",
    "linkify-it": "^5.0.1",
    "js-cookie": "^3.0.7",
    "vitest": {
      "vite": "^6.4.3"
    },
    "vite-node": {
      "vite": "^6.4.3"
    }
  }
